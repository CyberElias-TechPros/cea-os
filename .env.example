# ============================================================================
# CEA-OS environment variables (NO real secrets — copy to .env.local / Vercel)
# ============================================================================

# --- Frontend (apps/web) ---
# Public base URL of the API worker (must be reachable from the browser).
NEXT_PUBLIC_API_URL=https://api.cea.academy
# Public base URL of this frontend.
NEXT_PUBLIC_APP_URL=https://cea.academy

# --- API worker (workers/api) secrets — set with `wrangler secret put` ---
# Do NOT commit these. Provided here for reference only.
# JWT_SECRET=<long random string, e.g. output of `openssl rand -base64 64`>
# R2_ACCOUNT_ID=<Cloudflare account id>
# R2_ACCESS_KEY_ID=<R2 API token access key id>
# R2_SECRET_ACCESS_KEY=<R2 API token secret>
# R2_BUCKET=cea-uploads

# --- Email worker secrets ---
# RESEND_API_KEY=<resend api key>        (preferred)
# SENDGRID_API_KEY=<sendgrid api key>    (alternative)
# EMAIL_FROM=noreply@cea.academy

# --- Optional third-party ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENTRY_DSN=
